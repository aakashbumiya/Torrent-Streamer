{
  "name": "lan-torrent-streamer",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve --proxy-config proxy.conf.json",
    "start:lan": "ng serve --host 0.0.0.0 --port 4200 --proxy-config proxy.conf.json",
    "start:backend": "node server.mjs",
    "start:full": "npm run build && node server.mjs",
    "build": "ng build",
    "copy-sw": "node scripts/copy-webtorrent-sw.mjs",
    "postinstall": "npm run copy-sw"
  },
  "dependencies": {
    "@angular/common": "21.2.6",
    "@angular/compiler": "21.2.6",
    "@angular/core": "21.2.6",
    "@angular/platform-browser": "21.2.6",
    "bonjour-service": "^1.4.4",
    "ffmpeg-static": "^5.3.0",
    "multicast-dns": "^7.2.5",
    "qrcode": "^1.5.4",
    "webtorrent": "^3.0.21",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.24",
    "@angular/cli": "21.2.6",
    "@angular/compiler-cli": "21.2.6",
    "@types/qrcode": "^1.5.6",
    "typescript": "~5.9.2"
  }
}
